# =====================================================================
# Gutters AI Estimator — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# =====================================================================

# ---- Database (Neon Postgres) ---------------------------------------
# Get this from: https://console.neon.tech/app/projects → Connection Details
# Use the *pooled* connection string (ends in -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional direct (non-pooled) URL for migrations. Recommended on Neon.
# DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Auth (Clerk) --------------------------------------------------
# Get from: https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Webhook signing secret from Clerk dashboard → Webhooks → Endpoints
CLERK_WEBHOOK_SECRET="whsec_..."

# Routes Clerk should redirect to
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ---- Admin elevation -----------------------------------------------
# Comma-separated emails that auto-elevate to SUPER_ADMIN on sign-in.
# Whoever owns these emails gets full /admin/* access.
ADMIN_EMAILS="you@example.com"

# ---- API key vault encryption --------------------------------------
# Used to encrypt API keys stored in the api_keys table at rest.
# Generate via: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# ---- AI / Mapping APIs (will be moved into the encrypted vault) -----
GOOGLE_MAPS_API_KEY=""
OPENAI_API_KEY=""
NEARMAP_API_KEY=""
RESEND_API_KEY=""

# ---- Stripe (PLATFORM billing — the app charging contractors) -------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Contractor invoicing rails (Square / Stripe / Stax) ------------
# No env keys needed: each contractor pastes their OWN processor API key
# in Settings -> Payments; keys are AES-encrypted per-tenant with
# APP_ENCRYPTION_KEY. The only knob here is the Square host override for
# sandbox testing (default: production).
# SQUARE_ENV="sandbox"

# ---- Public app URL (used in proposal portal links) -----------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Verified sender for ALL outgoing mail (proposals, receipts, reminders,
# crew invites). MUST be on a domain you've verified in Resend —
# without it mail falls back to onboarding@resend.dev and lands in spam.
RESEND_FROM_EMAIL=
